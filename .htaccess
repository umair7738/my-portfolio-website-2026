RewriteEngine On

# Consolidate the two production hostnames and HTTP variants on the canonical origin.
RewriteCond %{HTTP_HOST} ^(?:www\.)?umair-builds\.in$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.umair-builds\.in$ [NC]
RewriteRule ^ https://umair-builds.in%{REQUEST_URI} [R=301,L,NE]

# Keep the homepage canonical at / instead of exposing a duplicate /index.html URL.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ https://umair-builds.in/ [R=301,L,NE]

# Redirect legacy page URLs to their clean equivalents.
RewriteCond %{THE_REQUEST} \s/+((?:about|projects|case-studies|services|skills|experience|contact|privacy))\.html(?:[?\s]) [NC]
RewriteRule ^(about|projects|case-studies|services|skills|experience|contact|privacy)\.html$ /$1 [R=301,L,NE]

# Serve the existing HTML files at clean, extensionless URLs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(about|projects|case-studies|services|skills|experience|contact|privacy)/?$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(?:css|js|woff2|webp|avif|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
