RewriteEngine On

# Consolidate the two production hostnames and HTTP variants on the canonical origin.
RewriteCond %{HTTP_HOST} ^(?:www\.)?umair-builds\.in$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.umair-builds\.in$ [NC]
RewriteRule ^ https://umair-builds.in%{REQUEST_URI} [R=301,L,NE]

# Keep the homepage canonical at / instead of exposing a duplicate /index.html URL.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ https://umair-builds.in/ [R=301,L,NE]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Prevent the portfolio from being embedded in an attacker-controlled frame.
  # Keep the existing HTTPS-upgrade directive while adding frame protection.
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(?:css|js|woff2|webp|avif|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
